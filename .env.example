# Local: DATABASE_URL=sqlite:///local.sqlite3
# Production: copy the managed PostgreSQL URL to GitHub Actions Secrets and Streamlit Secrets.
DATABASE_URL=sqlite:///local.sqlite3
GITHUB_TOKEN=
MAX_REPOS=50
MAX_CANDIDATES=320
MAX_PAGES_PER_SOURCE=6
SEARCH_PAGES_PER_QUERY=2
PER_PAGE=100
FRESHNESS_DAYS=30
BACKFILL_DAYS=180
COMPARISON_DAYS=90
OVERLAP_HOURS=48
MAX_RETRIES=4
TIMEOUT_SECONDS=20
STALE_HOURS=12
